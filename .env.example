# Telegram Bot Configuration
# Получите токен от @BotFather в Telegram
BOT_TOKEN=your_bot_token_here

# ID канала для проверки подписки (формат: @channel_name или -100xxxxxxxxx)
# Для получения ID канала можно использовать @userinfobot
CHANNEL_ID=@DusenkoRoman

# URL канала для кнопки подписки
CHANNEL_URL=https://t.me/DusenkoRoman

# Путь к шрифту для PDF (должен поддерживать кириллицу)
# Скачайте, например, Roboto или Montserrat .ttf файл
FONT_PATH=assets/font.ttf
